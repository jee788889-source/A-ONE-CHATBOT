# =============================================================================
# A-ONE Restaurant — Environment Configuration Template
# Place actual secrets in .env.local (do NOT commit secrets)
# =============================================================================

# Application
NODE_ENV=development
APP_NAME="A-ONE Restaurant"
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=
DIRECT_DATABASE_URL=
REDIS_URL=

# Owner Security (Server-Enforced)
OWNER_EMAIL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# AI Provider Configuration
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-20241022
AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_AUTO_REPLY=true

# Email / Notifications (Optional - to be configured by owner)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_API_KEY=
SMS_SENDER_ID=

# Restaurant Alerts (Optional)
ORDER_NOTIFY_EMAIL=
ORDER_NOTIFY_PHONE=

# Branding (Public)
NEXT_PUBLIC_BRAND_NAME="A-ONE Restaurant"
NEXT_PUBLIC_BRAND_URL=https://www.instagram.com/aone_foods/
NEXT_PUBLIC_BRAND_TAGLINE="Authentic Taste, Premium Quality & Traditional Savories"
