generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------- Enums -----

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum Channel {
  WHATSAPP
  WEB
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum MessageRole {
  USER
  ASSISTANT
  STAFF
  SYSTEM
}

enum MessageType {
  TEXT
  MENU
  ORDER_SUMMARY
  IMAGE
  LOCATION
  TEMPLATE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum PaymentStatus {
  PENDING
  PENDING_VERIFICATION
  PAID
  CASH_ON_DELIVERY
  FAILED
  REJECTED
}

// ---------------------------------------------------------------- Models ----

/// Staff accounts managed directly by the Owner. No public registration.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         Role       @default(STAFF)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  lastActiveAt DateTime?
  invitedBy    String?
  permissions  String[]   @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedConversations Conversation[]
  assignedOrders        Order[]
  auditLogs             AuditLog[]
  notifications         Notification[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

/// Customers ordering or chatting via WhatsApp or Web.
model Customer {
  id          String   @id @default(cuid())
  phone       String   @unique
  name        String?
  email       String?
  address     String?
  notes       String?
  totalOrders Int      @default(0)
  totalSpent  Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  orders        Order[]

  @@index([phone])
  @@map("customers")
}

/// WhatsApp and Web chat sessions.
model Conversation {
  id              String             @id @default(cuid())
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel         Channel            @default(WHATSAPP)
  status          ConversationStatus @default(OPEN)
  assignedStaffId String?
  assignedStaff   User?              @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  unreadCount     Int                @default(0)
  lastMessageAt   DateTime           @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  orders   Order[]

  @@index([customerId])
  @@index([status])
  @@index([assignedStaffId])
  @@index([lastMessageAt])
  @@map("conversations")
}

/// Inbound and outbound chat messages.
model Message {
  id                String        @id @default(cuid())
  conversationId    String
  conversation      Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role              MessageRole
  content           String        @db.Text
  messageType       MessageType   @default(TEXT)
  whatsappMessageId String?       @unique
  status            MessageStatus @default(SENT)
  mediaUrl          String?
  metadata          Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([whatsappMessageId])
  @@index([createdAt])
  @@map("messages")
}

/// Menu Categories (e.g. Burgers, Biryani, BBQ, Fast Food, Drinks, Desserts).
model MenuCategory {
  id           String   @id @default(cuid())
  name         String
  urduName     String?
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("menu_categories")
}

/// Menu Items available for ordering.
model MenuItem {
  id              String       @id @default(cuid())
  categoryId      String
  category        MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  urduName        String?
  description     String?      @db.Text
  price           Float
  imageUrl        String?
  isAvailable     Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  displayOrder    Int          @default(0)
  preparationTime Int?         @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([isFeatured])
  @@map("menu_items")
}

/// Food orders received via WhatsApp or staff entry.
model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  status        OrderStatus   @default(NEW)
  orderType     OrderType     @default(DELIVERY)
  paymentStatus PaymentStatus @default(CASH_ON_DELIVERY)

  subtotal    Float
  deliveryFee Float @default(0)
  discount    Float @default(0)
  total       Float

  customerName    String
  customerPhone   String
  deliveryAddress String? @db.Text
  notes           String? @db.Text

  paymentMethod     String?   @default("CASH_ON_DELIVERY")
  paymentReference  String?
  paymentScreenshot String?
  paymentVerifiedBy String?
  paymentVerifiedAt DateTime?
  paymentNotes      String?

  assignedStaffId String?
  assignedStaff   User?   @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  cancelledReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([orderType])
  @@index([createdAt])
  @@map("orders")
}

/// Line items in an order.
model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  itemName  String
  unitPrice Float
  quantity  Int
  subtotal  Float
  notes     String?

  @@index([orderId])
  @@map("order_items")
}

/// Central configuration for A-ONE Restaurant.
model RestaurantSettings {
  id                String   @id @default("default")
  name              String   @default("A-ONE Restaurant")
  tagline           String   @default("Authentic Taste & Premium Quality")
  phone             String   @default("+92 300 0000000")
  email             String   @default("contact@aonefoods.com")
  address           String   @default("A-ONE Restaurant, Main Boulevard, Pakistan")
  currency          String   @default("PKR")
  currencySymbol    String   @default("Rs.")
  deliveryFee       Float    @default(150)
  minOrderAmount    Float    @default(500)
  isAcceptingOrders Boolean  @default(true)

  openingHours     Json     @default("{\"monday\":{\"open\":\"11:00\",\"close\":\"01:00\",\"isOpen\":true},\"tuesday\":{\"open\":\"11:00\",\"close\":\"01:00\",\"isOpen\":true},\"wednesday\":{\"open\":\"11:00\",\"close\":\"01:00\",\"isOpen\":true},\"thursday\":{\"open\":\"11:00\",\"close\":\"01:00\",\"isOpen\":true},\"friday\":{\"open\":\"14:00\",\"close\":\"02:00\",\"isOpen\":true},\"saturday\":{\"open\":\"11:00\",\"close\":\"02:00\",\"isOpen\":true},\"sunday\":{\"open\":\"11:00\",\"close\":\"01:00\",\"isOpen\":true}}")
  deliverySettings Json     @default("{\"standardDeliveryFee\":150,\"freeDeliveryThreshold\":2000,\"estimatedMinutes\":35,\"allowedAreas\":[\"City Center\",\"Commercial Area\",\"Model Town\",\"Gulberg\",\"DHA\"]}")
  paymentAccounts  Json     @default("{\"jazzcash\":{\"accountTitle\":\"A-ONE Restaurant\",\"accountNumber\":\"0300-1234567\"},\"easypaisa\":{\"accountTitle\":\"A-ONE Restaurant\",\"accountNumber\":\"0321-9876543\"},\"bank\":{\"bankName\":\"Meezan Bank / Alfalah\",\"accountTitle\":\"A-ONE Foods PVT LTD\",\"iban\":\"PK00MEZN0000123456789012\"}}")
  whatsappConfig   Json     @default("{\"welcomeMessage\":\"Welcome to A-ONE Restaurant! 🍔🍕\\nHow may we serve you today?\\nType *Menu* to see our dishes or *Order* to start an order.\",\"autoReplyEnabled\":true,\"fallbackMessage\":\"Thank you for contacting A-ONE Restaurant. A staff member will assist you shortly.\"}")
  aiSettings       Json     @default("{\"provider\":\"anthropic\",\"model\":\"claude-3-5-sonnet-20241022\",\"temperature\":0.2,\"maxTokens\":500,\"strictGuardrails\":true}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurant_settings")
}

/// Immutable audit log for security, staff actions, and compliance.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String
  target     String?
  details    Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([actorEmail])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Internal notifications for staff & owner.
model Notification {
  id      String   @id @default(cuid())
  userId  String?
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  message String   @db.Text
  type    String   @default("INFO")
  link    String?
  isRead  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
